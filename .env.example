NODE_ENV=development
PORT=3000

# Use mock para desenvolvimento sem custo:
# AI_PROVIDER=mock

# Use qualquer provedor compatível com OpenAI Chat Completions:
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=your_key_here
AI_MODEL=gpt-4o-mini
AI_INPUT_COST_PER_1M_TOKENS=0
AI_OUTPUT_COST_PER_1M_TOKENS=0

# Exemplo xAI/Grok:
# AI_BASE_URL=https://api.x.ai/v1
# AI_API_KEY=your_xai_key_here
# AI_MODEL=grok-4
# AI_INPUT_COST_PER_1M_TOKENS=0
# AI_OUTPUT_COST_PER_1M_TOKENS=0

# Exemplo Google Gemini:
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_API_KEY=your_gemini_key_here
# AI_MODEL=gemini-3.5-flash
# AI_INPUT_COST_PER_1M_TOKENS=0
# AI_OUTPUT_COST_PER_1M_TOKENS=0
